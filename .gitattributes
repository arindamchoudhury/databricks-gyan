# Normalize line endings across Windows (CRLF) and sandbox/Linux (LF) edits.
# Text files are stored with LF in the repo; Git handles checkout conversion.

* text=auto

# Source and content files: always LF in the repo
*.md    text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.ipynb text eol=lf
*.tf    text eol=lf
*.hcl   text eol=lf

# Binary assets: never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary
